// ─── ガチャシリーズ ────────────────────────────────────────────────────────────

model Gacha {
  id             String   @id @default(cuid())
  seriesName     String
  ipName         String
  ipCategory     String   @default("other")
  category       String
  status         String   @default("on_sale")
  price          Int
  gradientFrom   String
  gradientTo     String
  lineup         String[] @default([])
  isReissue      Boolean  @default(false)
  postCount      Int      @default(0)
  // スクレイパー由来フィールド
  genre          String?
  imageUrl       String?
  releaseDate    DateTime?
  maker          String?
  sourceUrl      String?
  wpPostId       Int?     @unique
  isOnSale       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  machines        Machine[]
  posts           Post[]
  stockPosts      StockPost[]
  gachaLikes      GachaLike[]
  homeFeatured    HomeFeatured[]
}

// ─── ホーム掲載枠（管理者が手動設定する掲載。今週発売 / 再販 など） ──────────────
model HomeFeatured {
  id        String   @id @default(cuid())
  section   String   // 'weekly'（今週発売） | 'reissue'（再販） など
  gachaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  gacha Gacha @relation(fields: [gachaId], references: [id], onDelete: Cascade)

  @@unique([section, gachaId])
  @@index([section, sortOrder])
}

model GachaLike {
  id        String   @id @default(cuid())
  userId    String
  gachaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gacha Gacha @relation(fields: [gachaId], references: [id], onDelete: Cascade)

  @@unique([userId, gachaId])
}
