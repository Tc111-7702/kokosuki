// ─── ガチャシリーズ ────────────────────────────────────────────────────────────

model Gacha {
  id           String    @id @default(cuid())
  seriesName   String
  // #19 正規化: IP は IpName リレーション(ipNameId)で参照する。
  // 除外 ipName（ジャンル名/不明）のガチャは ipNameId=null のため nullable のまま。
  ipNameId     String?
  category     String
  status       String    @default("on_sale")
  price        Int
  gradientFrom String
  gradientTo   String
  lineup       String[]  @default([])
  isReissue    Boolean   @default(false)
  postCount    Int       @default(0)
  // スクレイパー由来フィールド
  genre        String?
  imageUrl     String?
  releaseDate  DateTime?
  maker        String?
  sourceUrl    String?
  wpPostId     Int?      @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  machines    Machine[]
  posts       Post[]
  stockPosts  StockPost[]
  gachaLikes  GachaLike[]
  reissuePickup ReissuePickup?
  weeklyPickup  WeeklyPickup?
  ip          IpName?      @relation(fields: [ipNameId], references: [id])

  @@index([ipNameId])
  @@index([status])
}

// ─── IP正規化（3階層: IpCategory 1—* IpName 1—* Gacha）#19 ─────────────────────
// Expand フェーズ: テーブル追加のみ。読み書きは既存の Gacha.ipName/ipCategory(string)
// のままで、Backfill→読み替え→Contract の順に移行する。

model IpCategory {
  id        String   @id @default(cuid())
  key       String   @unique // 安定slug: 'anime' | 'character' | 'other' 等
  name      String // 表示名（例: アニメ・漫画・ゲーム）
  sortOrder Int      @default(0)
  ipNames   IpName[]
}

model IpName {
  id         String     @id @default(cuid())
  name       String     @unique
  categoryId String
  category   IpCategory @relation(fields: [categoryId], references: [id])
  gachas     Gacha[]

  @@index([categoryId])
}

model GachaLike {
  id        String   @id @default(cuid())
  userId    String
  gachaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gacha Gacha @relation(fields: [gachaId], references: [id], onDelete: Cascade)

  @@unique([userId, gachaId])
}

// ホームのピックアップ枠（admin と共有）。管理者が手動で選定してホームの各セクションに掲載する。
// 旧 HomePickup(section で2用途を兼ねた)を、用途ごとに別テーブルへ分割。
// 再販・また引ける（既存と同じカラム構成）。
model ReissuePickup {
  id        String   @id @default(cuid())
  gachaId   String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  gacha Gacha @relation(fields: [gachaId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
}

// 今週発売。ガチャ詳細をカスタム表示するため、発売通知の購読と「楽しみの声」を併せ持つ。
model WeeklyPickup {
  id        String   @id @default(cuid())
  gachaId   String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  gacha    Gacha                 @relation(fields: [gachaId], references: [id], onDelete: Cascade)
  voices   WeeklyVoice[]

  @@index([sortOrder])
}

// 楽しみの声（1ユーザー何回でも／いいね・返信なし）。WeeklyPickup 削除で cascade 削除。
model WeeklyVoice {
  id        String   @id @default(cuid())
  pickupId  String
  userId    String
  text      String
  createdAt DateTime @default(now())

  pickup WeeklyPickup @relation(fields: [pickupId], references: [id], onDelete: Cascade)

  @@index([pickupId, createdAt])
}

// スクレイプ実行の記録テーブル。実行時刻は GitHub Actions cron + コード定数(SCRAPE_TIMES)で
// 固定管理するため、予約設定(everyDays/atTime)やロック(lockedAt)は廃止。
// lastRunAt のみで「本日未実行か（due判定）」を判断する。
model ScrapeSchedule {
  type      String    @id // 'gacha' | 'phone'
  lastRunAt DateTime? // 最後に成功実行した時刻（due判定に使用）
}
