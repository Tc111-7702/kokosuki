// ─── スポット・マシン ──────────────────────────────────────────────────────────

model Spot {
  id            String   @id @default(cuid())
  name          String
  address       String
  lat           Float
  lng           Float
  googlePlaceId String?  @unique
  gachaIslandId Int?     @unique
  phone         String?
  googleMapsUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machines Machine[]
  pulls    Pull[]
  qaItems  QA[]
}

model Machine {
  id        String   @id @default(cuid())
  spotId    String
  gachaId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spot  Spot  @relation(fields: [spotId], references: [id], onDelete: Cascade)
  gacha Gacha @relation(fields: [gachaId], references: [id], onDelete: Cascade)
  pulls Pull[]

  @@unique([spotId, gachaId])
}
