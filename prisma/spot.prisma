// ─── スポット・マシン ──────────────────────────────────────────────────────────

model Spot {
  id            String   @id @default(cuid())
  name          String
  address       String
  lat           Float
  lng           Float
  googlePlaceId String?  @unique
  gachaIslandId Int?     @unique
  phone         String?
  googleMapsUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machines   Machine[]
  posts      Post[]
  stockPosts StockPost[]
  qaItems    QA[]
  reviews    SpotReview[]
}

model Machine {
  id            String    @id @default(cuid())
  spotId        String
  gachaId       String
  // 可用性（Gacha.status と対称）: 'on_sale' | 'ended'。店舗がその商品を扱わなくなったら
  // ended にする（削除しない＝紐づく投稿/報告を Cascade で失わないため）。既定は on_sale。
  // ※在庫(stockStatus)とは別軸。stockStatus は在庫あり/なし/不明(null)。
  status        String    @default("on_sale")
  stockStatus   String?
  stockSyncedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  spot       Spot        @relation(fields: [spotId], references: [id], onDelete: Cascade)
  gacha      Gacha       @relation(fields: [gachaId], references: [id], onDelete: Cascade)
  posts      Post[]
  stockPosts StockPost[]

  @@unique([spotId, gachaId])
}

// ─── 口コミ ───────────────────────────────────────────────────────────────────

model SpotReview {
  id        String   @id @default(cuid())
  spotId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spot    Spot              @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies SpotReviewReply[]
  likes   SpotReviewLike[]

  @@index([spotId])
  @@index([userId])
}

model SpotReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review SpotReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model SpotReviewLike {
  id       String @id @default(cuid())
  userId   String
  reviewId String

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  review SpotReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}
