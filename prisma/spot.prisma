// ─── スポット・マシン ──────────────────────────────────────────────────────────

model Spot {
  id            String   @id @default(cuid())
  name          String
  address       String
  lat           Float
  lng           Float
  googlePlaceId String?  @unique
  gachaIslandId Int?     @unique
  phone         String?
  googleMapsUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machines Machine[]
  posts    Post[]
  qaItems  QA[]
}

model Machine {
  id            String    @id @default(cuid())
  spotId        String
  gachaId       String
  stockStatus   String?
  stockSyncedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  spot  Spot  @relation(fields: [spotId], references: [id], onDelete: Cascade)
  gacha Gacha @relation(fields: [gachaId], references: [id], onDelete: Cascade)
  posts Post[]

  @@unique([spotId, gachaId])
}
