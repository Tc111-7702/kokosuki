// ─── 投稿・いいね・Q&A ──────────────────────────────────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  machineId String
  spotId    String
  userId    String
  gachaId   String
  result    String
  itemName  String?
  imageUrl  String?
  memo      String?
  createdAt DateTime @default(now())

  machine Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  spot    Spot        @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gacha   Gacha       @relation(fields: [gachaId], references: [id], onDelete: Cascade)
  likes   Like[]
  replies PostReply[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

// ─── 返信・返信いいね ─────────────────────────────────────────────────────────────────────────────────────

model PostReply {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  text      String
  createdAt DateTime @default(now())

  post     Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   PostReply?      @relation("ReplyTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children PostReply[]     @relation("ReplyTree")
  likes    PostReplyLike[]
}

model PostReplyLike {
  id        String   @id @default(cuid())
  userId    String
  replyId   String
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply PostReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, replyId])
}

model QA {
  id        String   @id @default(cuid())
  spotId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  spot    Spot       @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QAAnswer[]
}

model QAAnswer {
  id        String   @id @default(cuid())
  qaId      String
  userId    String
  text      String
  createdAt DateTime @default(now())

  qa   QA   @relation(fields: [qaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── 在庫ポスト ───────────────────────────────────────────────────────────────────────────────────

model StockPost {
  id          String   @id @default(cuid())
  machineId   String
  spotId      String
  gachaId     String
  userId      String
  stockStatus String
  createdAt   DateTime @default(now())

  machine Machine          @relation(fields: [machineId], references: [id], onDelete: Cascade)
  spot    Spot             @relation(fields: [spotId], references: [id], onDelete: Cascade)
  gacha   Gacha            @relation(fields: [gachaId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes   StockPostLike[]
  replies StockPostReply[]
}

model StockPostLike {
  id          String   @id @default(cuid())
  userId      String
  stockPostId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockPost StockPost @relation(fields: [stockPostId], references: [id], onDelete: Cascade)

  @@unique([userId, stockPostId])
}

model StockPostReply {
  id          String   @id @default(cuid())
  stockPostId String
  userId      String
  text        String
  createdAt   DateTime @default(now())

  stockPost StockPost @relation(fields: [stockPostId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
