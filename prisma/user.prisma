// ─── Better Auth ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  birthDate     DateTime? @db.Date
  image         String?
  role          String    @default("user") // 権限（既定 'user'）。20260810 の add_user_role で追加。
  isActive      Boolean   @default(true) // アカウント有効/無効（false = BAN・凍結）。既定は有効。
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  profile           UserProfile?
  posts             Post[]
  likes             Like[]
  gachaLikes        GachaLike[]
  postReplies       PostReply[]
  postReplyLikes    PostReplyLike[]
  stockPosts        StockPost[]
  stockPostLikes    StockPostLike[]
  stockPostReplies  StockPostReply[]
  qaItems           QA[]
  qaAnswers         QAAnswer[]
  notifications     Notification[]
  spotReviews       SpotReview[]
  spotReviewReplies SpotReviewReply[]
  spotReviewLikes   SpotReviewLike[]
  following         Follow[]          @relation("Following") // 自分がフォローしている
  followers         Follow[]          @relation("Followers") // 自分をフォローしている
  reportsMade       Report[]          @relation("ReportsMade")
  reportsReceived   Report[]          @relation("ReportsReceived")
  inquiries         Inquiry[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 新規登録: メール OTP 認証後〜本登録までの一時状態（30分有効）
model SignupPending {
  id               String    @id @default(cuid())
  email            String    @unique
  tokenHash        String    @unique
  passwordEnc      String?
  name             String?
  birthDate        DateTime? @db.Date
  handle           String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([expiresAt])
}

// ─── ユーザープロフィール ──────────────────────────────────────────────────────

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  handle      String?  @unique
  bio         String?
  // 好きIP（お気に入りガチャのIPから選択・プロフィールに表示）
  favoriteIps String[] @default([])
  // 地図の検索範囲（メートル）
  mapRadiusM  Int      @default(20000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── フォロー ──────────────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(cuid())
  followerId  String // フォローする側
  followingId String // フォローされる側
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
