// ─── Better Auth ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  accounts         Account[]
  profile          UserProfile?
  posts            Post[]
  likes            Like[]
  gachaLikes       GachaLike[]
  postReplies      PostReply[]
  postReplyLikes   PostReplyLike[]
  stockPosts       StockPost[]
  stockPostLikes   StockPostLike[]
  stockPostReplies StockPostReply[]
  qaItems          QA[]
  qaAnswers        QAAnswer[]
  notifications    Notification[]
  spotReviews        SpotReview[]
  spotReviewReplies  SpotReviewReply[]
  spotReviewLikes    SpotReviewLike[]
  following          Follow[] @relation("Following")  // 自分がフォローしている
  followers          Follow[] @relation("Followers")  // 自分をフォローしている
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── ユーザープロフィール ──────────────────────────────────────────────────────

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  handle    String?  @unique
  avatarUrl String?
  bio       String?
  // 好きIP（お気に入りガチャのIPから選択・プロフィールに表示）
  favoriteIps String[] @default([])
  // 通知設定（実装済みの2系統のみ）
  notifyFavoriteStock Boolean @default(true)
  notifyReaction      Boolean @default(true)
  // 地図の検索範囲（メートル）
  mapRadiusM Int @default(20000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── フォロー ──────────────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(cuid())
  followerId  String   // フォローする側
  followingId String   // フォローされる側
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
