// ─── Better Auth ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  accounts         Account[]
  profile          UserProfile?
  posts            Post[]
  likes            Like[]
  gachaLikes       GachaLike[]
  postReplies      PostReply[]
  postReplyLikes   PostReplyLike[]
  stockPosts       StockPost[]
  stockPostLikes   StockPostLike[]
  stockPostReplies StockPostReply[]
  qaItems          QA[]
  qaAnswers        QAAnswer[]
  notifications    Notification[]
  favoriteGachas   UserFavoriteGacha[]
  spotReviews        SpotReview[]
  spotReviewReplies  SpotReviewReply[]
  spotReviewLikes    SpotReviewLike[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── ユーザープロフィール ──────────────────────────────────────────────────────

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  handle    String?  @unique
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── お気に入りガチャ ──────────────────────────────────────────────────────────

model UserFavoriteGacha {
  id        String   @id @default(cuid())
  userId    String
  gachaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gacha Gacha @relation(fields: [gachaId], references: [id], onDelete: Cascade)

  @@unique([userId, gachaId])
}
